# ===== 群机器人配置模板 =====
# 复制为 .env 并填写实际值

# NapCat 正向 WebSocket 连接（二选一）
# 方式A：baseUrl
NAPCAT_BASE_URL=ws://127.0.0.1:3001
# 方式B：host/port（二选一，优先 baseUrl）
NAPCAT_PROTOCOL=ws
NAPCAT_HOST=127.0.0.1
NAPCAT_PORT=3001
# NapCat WebSocket 鉴权 token（如未开启可留空）
NAPCAT_TOKEN=

# 机器人管理的 QQ 群（逗号分隔的群号）
ALLOWED_GROUPS=

# 管理员 QQ 号（逗号分隔，拥有核销等高权限操作）
ADMIN_QQ=

# 官网 API
OFFICIAL_API_BASE=https://xuanjian.top
# 官网为机器人分配的只读 Token（若官网已提供）
OFFICIAL_BOT_TOKEN=
# 官网站点根地址（生成扫码/海报链接用；留空则回退 OFFICIAL_API_BASE）
OFFICIAL_SITE_BASE=https://xuanjian.top

# ===== 支付播报（缺省 off：不轮询、不定时报，指令仍可用）=====
# on 时才启用：待审批 60s 轮询推送 + 每月 1 日 10:00 月报图 + 每周一 09:00 文字周报
PAY_BROADCAST=off
# 播报群（月报图 + 文字周报），默认 860336849
BROADCAST_GROUP_ID=860336849
# 待审批推送群，留空 = 与 BROADCAST_GROUP_ID 相同
APPROVAL_GROUP_ID=
